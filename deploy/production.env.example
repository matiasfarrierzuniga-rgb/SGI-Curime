# Copy outside the repository and restrict file permissions to the deployment user.
# Replace every empty required value before running Compose. Do not commit the real file.
SITE_DOMAIN=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Both URLs must use the private host postgres:5432 and URL-encode special password characters.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=

# Optional application settings; uncomment only when overriding defaults in compose.prod.yaml.
# JWT_EXPIRES_IN=1h
# REFRESH_TOKEN_TTL=2592000
# REFRESH_COOKIE_NAME=sgi_refresh
# ACTIVATION_TOKEN_TTL_HOURS=24
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# MAX_LOGIN_ATTEMPTS=5
# ACCOUNT_LOCKOUT_MINUTES=15
# PUBLIC_REQUEST_RATE_LIMIT_TTL_SECONDS=60
# PUBLIC_REQUEST_RATE_LIMIT_MAX=5

# Email remains disabled until a verified sender and provider are configured.
EMAIL_PROVIDER=fake
EMAIL_SEND_ENABLED=false
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_TIMEOUT_MS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
