# PostgreSQL
POSTGRES_USER=sgi_user
POSTGRES_PASSWORD=sgi_local_password
POSTGRES_DB=sgi_curime
POSTGRES_PORT=5432

# Puertos
BACKEND_PORT=3000
FRONTEND_PORT=5173

# URLs
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Administrador inicial local
ADMIN_NAME=Administrador Local
ADMIN_IDENTIFICATION=DEVADMIN001
ADMIN_EMAIL=admin@sgi.local
ADMIN_PASSWORD=AdminLocal123

# JWT
JWT_SECRET=dev-only-change-this-secret-before-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL=2592000
REFRESH_COOKIE_NAME=sgi_refresh
REFRESH_COOKIE_SAME_SITE=lax

# Seguridad
ACTIVATION_TOKEN_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PUBLIC_REQUEST_RATE_LIMIT_TTL_SECONDS=60
PUBLIC_REQUEST_RATE_LIMIT_MAX=5

# Correo
EMAIL_PROVIDER=fake
EMAIL_SEND_ENABLED=false
EMAIL_FROM=
EMAIL_FROM_NAME=Asociación de Desarrollo Integral de Curime
EMAIL_REPLY_TO=
GMAIL_USER=
GMAIL_APP_PASSWORD=
