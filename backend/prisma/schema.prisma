generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Person {
  id                            Int                              @id @default(autoincrement())
  firstName                     String?
  firstSurname                  String?
  secondSurname                 String?
  legacyFullName                String?
  identification                String?
  identificationType            IdentificationType?
  normalizedIdentification      String?
  birthDate                     DateTime?
  email                         String?
  phoneCountryCode              String?
  phoneNationalNumber           String?
  address                       String?
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  affiliate                     Affiliate?
  affiliateRequests             AffiliateRequest[]
  reconciliationManifestEntries IdentityReconciliationManifest[] @relation("ManifestSelectedPerson")
  user                          User?
  userRequests                  UserRequest[]

  @@unique([identificationType, normalizedIdentification])
}

model IdentityReconciliationManifest {
  id                         Int                 @id @default(autoincrement())
  manifestVersion            String
  normalizationVersion       String
  decisionVersion            String
  sourceModel                String
  sourceId                   Int
  sourceFingerprint          String
  rawIdentification          String?
  identificationType         IdentificationType?
  normalizedIdentification   String?
  identityClusterKey         String?
  classification             String
  selectedPersonId           Int?
  personCreationAllowed      Boolean
  conflictCodes              Json
  nameReconciliationRequired Boolean
  reviewRequired             Boolean
  sourceSnapshot             Json
  reviewedAt                 DateTime?
  reviewedBy                 String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  selectedPerson             Person?             @relation("ManifestSelectedPerson", fields: [selectedPersonId], references: [id])

  @@unique([normalizationVersion, decisionVersion, sourceModel, sourceId])
  @@index([identityClusterKey])
  @@index([classification, reviewRequired])
  @@index([selectedPersonId])
}

model User {
  id                         Int                      @id @default(autoincrement())
  fullName                   String
  identification             String                   @unique
  email                      String                   @unique
  phone                      String?
  address                    String?
  passwordHash               String?
  status                     UserStatus               @default(ACTIVE)
  failedLoginAttempts        Int                      @default(0)
  lockedAt                   DateTime?
  lastLoginAt                DateTime?
  roleId                     Int
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  identificationType         IdentificationType?
  phoneCountryCode           String?
  phoneNationalNumber        String?
  personId                   Int?                     @unique
  subscriptionExpirationDate DateTime?
  reviewedJustifications     AbsenceJustification[]   @relation("JustificationReviewer")
  activationTokens           AccountActivationToken[]
  reviewedAffiliateRequests  AffiliateRequest[]       @relation("AffiliateRequestReviewer")
  createdSanctions           AffiliateSanction[]      @relation("SanctionCreator")
  auditLogs                  AuditLog[]
  recordedFinancialMovements FinancialMovement[]      @relation("FinancialMovementRecorder")
  inventoryLoansCreated      InventoryLoan[]          @relation("LoanCreator")
  inventoryLoansReceived     InventoryLoan[]          @relation("LoanReceiver")
  inventoryMovements         InventoryMovement[]
  passwordResetTokens        PasswordResetToken[]
  recordedPayments           Payment[]                @relation("PaymentRecorder")
  approvedReservations       Reservation[]            @relation("ReservationApprover")
  requestedReservations      Reservation[]            @relation("ReservationRequester")
  sessions                   Session[]
  person                     Person?                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  role                       Role                     @relation(fields: [roleId], references: [id])
}

model Session {
  id               Int       @id @default(autoincrement())
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime  @default(now())
  userId           Int
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  module     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountActivationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserRequest {
  id                  Int                 @id @default(autoincrement())
  fullName            String
  identification      String
  email               String
  phone               String?
  address             String?
  reason              String
  status              RequestStatus       @default(PENDING)
  rejectionReason     String?
  reviewedAt          DateTime?
  reviewedById        Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  identificationType  IdentificationType?
  phoneCountryCode    String?
  phoneNationalNumber String?
  personId            Int?
  person              Person?             @relation(fields: [personId], references: [id])

  @@index([identification])
  @@index([email])
  @@index([status])
  @@index([personId])
}

model Affiliate {
  id                  Int                    @id @default(autoincrement())
  fullName            String
  identification      String                 @unique
  birthDate           DateTime
  gender              String?
  phone               String?
  email               String?                @unique
  address             String
  occupation          String?
  workplace           String?
  affiliateType       String?
  affiliationDate     DateTime               @default(now())
  status              AffiliateStatus        @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  identificationType  IdentificationType?
  phoneCountryCode    String?
  phoneNationalNumber String?
  personId            Int?                   @unique
  justifications      AbsenceJustification[]
  person              Person?                @relation(fields: [personId], references: [id], onDelete: Restrict)
  sanctions           AffiliateSanction[]
  attendances         AssemblyAttendance[]
  inventoryLoans      InventoryLoan[]
}

model AffiliateRequest {
  id                  Int                 @id @default(autoincrement())
  fullName            String
  identification      String
  birthDate           DateTime
  gender              String?
  phone               String?
  email               String?
  address             String
  occupation          String?
  workplace           String?
  affiliationReason   String
  status              RequestStatus       @default(PENDING)
  rejectionReason     String?
  reviewedAt          DateTime?
  reviewedById        Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  identificationType  IdentificationType?
  phoneCountryCode    String?
  phoneNationalNumber String?
  personId            Int?
  person              Person?             @relation(fields: [personId], references: [id])
  reviewedBy          User?               @relation("AffiliateRequestReviewer", fields: [reviewedById], references: [id])

  @@index([identification])
  @@index([email])
  @@index([status])
  @@index([reviewedById])
  @@index([personId])
}

model Assembly {
  id             Int                    @id @default(autoincrement())
  title          String
  type           String?
  date           DateTime
  place          String
  description    String?
  status         AssemblyStatus         @default(SCHEDULED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  justifications AbsenceJustification[]
  attendances    AssemblyAttendance[]

  @@index([date])
  @@index([status])
}

model Event {
  id                Int               @id @default(autoincrement())
  publicId          String            @unique @default(uuid())
  title             String
  summary           String
  description       String?
  startAt           DateTime
  endAt             DateTime?
  location          String?
  status            EventStatus       @default(SCHEDULED)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  reservations      Reservation[]

  @@index([publicationStatus, startAt])
  @@index([startAt])
}

model ReservableResource {
  id           Int                      @id @default(autoincrement())
  name         String
  description  String?
  location     String?
  capacity     Int?
  status       ReservableResourceStatus @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  price        Decimal?                 @db.Decimal(14, 2)
  pricingType  ResourcePricingType      @default(FREE)
  reservations Reservation[]

  @@index([status])
}

model Reservation {
  id                 Int                @id @default(autoincrement())
  startAt            DateTime
  endAt              DateTime
  purpose            String
  estimatedAttendees Int?
  notes              String?
  status             ReservationStatus  @default(PENDING)
  approvedAt         DateTime?
  rejectionReason    String?
  cancelledAt        DateTime?
  resourceId         Int
  requesterUserId    Int
  approvedById       Int?
  eventId            Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  financialCharge    FinancialCharge?
  approvedBy         User?              @relation("ReservationApprover", fields: [approvedById], references: [id])
  event              Event?             @relation(fields: [eventId], references: [id])
  requester          User               @relation("ReservationRequester", fields: [requesterUserId], references: [id])
  resource           ReservableResource @relation(fields: [resourceId], references: [id])

  @@index([requesterUserId])
  @@index([eventId])
  @@index([status])
  @@index([resourceId, startAt, endAt])
}

model FinancialCharge {
  id            Int                   @id @default(autoincrement())
  reservationId Int                   @unique
  amount        Decimal               @db.Decimal(14, 2)
  currency      String                @default("CRC")
  status        FinancialChargeStatus @default(PENDING)
  dueAt         DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  reservation   Reservation           @relation(fields: [reservationId], references: [id])
  payments      Payment[]

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id           Int             @id @default(autoincrement())
  chargeId     Int
  amount       Decimal         @db.Decimal(14, 2)
  status       PaymentStatus   @default(PENDING)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime?
  recordedById Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  charge       FinancialCharge @relation(fields: [chargeId], references: [id])
  recordedBy   User?           @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([chargeId])
  @@index([status])
  @@index([recordedById])
  @@index([createdAt])
}

model FinancialMovement {
  id           Int                     @id @default(autoincrement())
  type         FinancialMovementType
  source       FinancialMovementSource @default(MANUAL)
  amount       Decimal                 @db.Decimal(14, 2)
  currency     String                  @default("CRC")
  description  String
  reference    String?
  occurredAt   DateTime
  sourceId     Int?
  recordedById Int?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  recordedBy   User?                   @relation("FinancialMovementRecorder", fields: [recordedById], references: [id])

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([source, sourceId])
  @@index([recordedById])
}

model AssemblyAttendance {
  id            Int                   @id @default(autoincrement())
  status        AttendanceStatus
  registeredAt  DateTime              @default(now())
  observations  String?
  assemblyId    Int
  affiliateId   Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  justification AbsenceJustification?
  affiliate     Affiliate             @relation(fields: [affiliateId], references: [id])
  assembly      Assembly              @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@unique([assemblyId, affiliateId])
  @@index([assemblyId, status])
  @@index([affiliateId])
}

model AbsenceJustification {
  id                     Int                 @id @default(autoincrement())
  reason                 String
  status                 JustificationStatus @default(PENDING)
  rejectionReason        String?
  reviewedAt             DateTime?
  assemblyId             Int
  affiliateId            Int
  reviewedById           Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  decisionNote           String?
  attachmentOriginalName String?
  attachmentMimeType     String?
  attachmentSize         Int?
  attachmentUrl          String?
  affiliate              Affiliate           @relation(fields: [affiliateId], references: [id])
  attendance             AssemblyAttendance  @relation(fields: [assemblyId, affiliateId], references: [assemblyId, affiliateId], onDelete: Cascade)
  assembly               Assembly            @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  reviewedBy             User?               @relation("JustificationReviewer", fields: [reviewedById], references: [id])

  @@unique([assemblyId, affiliateId])
  @@index([status])
  @@index([reviewedById])
}

model AffiliateSanction {
  id          Int            @id @default(autoincrement())
  reason      String
  description String?
  date        DateTime       @default(now())
  status      SanctionStatus @default(ACTIVE)
  affiliateId Int
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id])
  createdBy   User           @relation("SanctionCreator", fields: [createdById], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@index([date])
  @@index([createdById])
}

model InventoryCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]

  @@index([isActive])
}

model InventoryItem {
  id              Int                    @id @default(autoincrement())
  code            String                 @unique
  name            String
  description     String?
  currentQuantity Int                    @default(0)
  minimumQuantity Int                    @default(0)
  unit            String                 @default("unidad")
  location        String?
  status          InventoryItemStatus    @default(ACTIVE)
  condition       InventoryItemCondition @default(GOOD)
  categoryId      Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  category        InventoryCategory      @relation(fields: [categoryId], references: [id])
  loans           InventoryLoan[]
  movements       InventoryMovement[]

  @@index([categoryId])
  @@index([status])
  @@index([condition])
}

model InventoryMovement {
  id          Int                   @id @default(autoincrement())
  type        InventoryMovementType
  quantity    Int
  reason      String
  reference   String?
  notes       String?
  itemId      Int
  createdById Int?
  createdAt   DateTime              @default(now())
  createdBy   User?                 @relation(fields: [createdById], references: [id])
  item        InventoryItem         @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model InventoryLoan {
  id                  Int                 @id @default(autoincrement())
  quantity            Int
  borrowerName        String
  loanDate            DateTime            @default(now())
  expectedReturnDate  DateTime
  returnedAt          DateTime?
  status              InventoryLoanStatus @default(ACTIVE)
  notes               String?
  itemId              Int
  borrowerAffiliateId Int?
  createdById         Int?
  receivedById        Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  affiliate           Affiliate?          @relation(fields: [borrowerAffiliateId], references: [id])
  createdBy           User?               @relation("LoanCreator", fields: [createdById], references: [id])
  item                InventoryItem       @relation(fields: [itemId], references: [id])
  receivedBy          User?               @relation("LoanReceiver", fields: [receivedById], references: [id])

  @@index([itemId])
  @@index([status])
  @@index([borrowerAffiliateId])
  @@index([createdById])
  @@index([expectedReturnDate])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
}

enum IdentificationType {
  NATIONAL
  DIMEX
}

enum AssemblyStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ReservableResourceStatus {
  ACTIVE
  INACTIVE
}

enum ResourcePricingType {
  FREE
  FIXED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CONFIRMED
  COMPLETED
}

enum FinancialChargeStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  SINPE_MOVIL
  OTHER
}

enum FinancialMovementType {
  INCOME
  EXPENSE
}

enum FinancialMovementSource {
  MANUAL
  RESERVATION_PAYMENT
  DONATION
}

enum PublicationStatus {
  INTERNAL
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  REVOKED
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum InventoryItemCondition {
  GOOD
  DAMAGED
  UNDER_REPAIR
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum InventoryLoanStatus {
  ACTIVE
  RETURNED
  CANCELLED
}
