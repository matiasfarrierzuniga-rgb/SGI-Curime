generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
}

enum AssemblyStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  REVOKED
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id             Int        @id @default(autoincrement())
  fullName       String
  identification String     @unique
  email          String     @unique
  phone          String?
  address        String?
  passwordHash   String?
  status         UserStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
  lastLoginAt         DateTime?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  activationTokens          AccountActivationToken[]
  passwordResetTokens       PasswordResetToken[]
  auditLogs                 AuditLog[]
  reviewedAffiliateRequests AffiliateRequest[]       @relation("AffiliateRequestReviewer")
  reviewedJustifications    AbsenceJustification[]   @relation("JustificationReviewer")
  createdSanctions          AffiliateSanction[]      @relation("SanctionCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  module     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountActivationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserRequest {
  id             Int           @id @default(autoincrement())
  fullName       String
  identification String
  email          String
  phone          String?
  address        String?
  reason         String
  status         RequestStatus @default(PENDING)

  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identification])
  @@index([email])
  @@index([status])
}

model Affiliate {
  id              Int             @id @default(autoincrement())
  fullName        String
  identification  String          @unique
  birthDate       DateTime
  gender          String?
  phone           String?
  email           String?         @unique
  address         String
  occupation      String?
  workplace       String?
  affiliateType   String?
  affiliationDate DateTime        @default(now())
  status          AffiliateStatus @default(ACTIVE)

  attendances    AssemblyAttendance[]
  justifications AbsenceJustification[]
  sanctions      AffiliateSanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateRequest {
  id                Int           @id @default(autoincrement())
  fullName          String
  identification    String
  birthDate         DateTime
  gender            String?
  phone             String?
  email             String?
  address           String
  occupation        String?
  workplace         String?
  affiliationReason String
  status            RequestStatus @default(PENDING)

  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    Int?
  reviewedBy      User?     @relation("AffiliateRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identification])
  @@index([email])
  @@index([status])
  @@index([reviewedById])
}

model Assembly {
  id          Int            @id @default(autoincrement())
  title       String
  type        String?
  date        DateTime
  place       String
  description String?
  status      AssemblyStatus @default(SCHEDULED)

  attendances    AssemblyAttendance[]
  justifications AbsenceJustification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
}

model AssemblyAttendance {
  id           Int              @id @default(autoincrement())
  status       AttendanceStatus
  registeredAt DateTime         @default(now())
  observations String?

  assemblyId  Int
  assembly    Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  affiliateId Int
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assemblyId, affiliateId])
  @@index([assemblyId, status])
  @@index([affiliateId])
}

model AbsenceJustification {
  id              Int                 @id @default(autoincrement())
  reason          String
  status          JustificationStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?

  assemblyId   Int
  assembly     Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  affiliateId  Int
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  reviewedById Int?
  reviewedBy   User?     @relation("JustificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assemblyId, affiliateId])
  @@index([status])
  @@index([reviewedById])
}

model AffiliateSanction {
  id          Int            @id @default(autoincrement())
  reason      String
  description String?
  date        DateTime       @default(now())
  status      SanctionStatus @default(ACTIVE)

  affiliateId Int
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  createdById Int
  createdBy   User      @relation("SanctionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([date])
  @@index([createdById])
}
