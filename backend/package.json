{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate --config prisma.config.ts",
    "build": "nest build",
    "postinstall": "prisma generate --config prisma.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:reconcile-persons": "tsx prisma/reconcile-persons.ts",
    "db:link-person-identities": "tsx prisma/link-person-identities.ts",
    "db:reconcile-legacy-user": "tsx prisma/reconcile-legacy-user.ts",
    "db:preflight:institutional-profile": "tsx prisma/preflight-institutional-profile.ts",
    "db:backfill:frozen-v1.1": "tsx prisma/backfill-frozen-v1-1.ts",
    "db:reset-admin-password": "tsx prisma/reset-admin-password.ts",
    "email:test": "tsx src/modules/notifications/infrastructure/scripts/send-test-email.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "pretest": "prisma generate --config prisma.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:migration:frozen-v1.1": "node ./test/migration/frozen-target-v1.1-disposable.mjs",
    "test:postgres:guard": "node --test ./test/helpers/disposable-postgres-guard.test.mjs",
    "test:postgres:up": "node ./test/helpers/disposable-postgres-lifecycle.mjs start",
    "test:postgres:health": "node ./test/helpers/disposable-postgres-lifecycle.mjs health",
    "test:postgres:migrate": "node ./test/helpers/disposable-postgres-lifecycle.mjs migrate",
    "test:postgres:smoke": "node ./test/helpers/disposable-postgres-lifecycle.mjs smoke",
    "test:postgres:cleanup": "node ./test/helpers/disposable-postgres-lifecycle.mjs cleanup",
    "test:postgres:down": "node ./test/helpers/disposable-postgres-lifecycle.mjs down",
    "test:postgres:certify": "node ./test/helpers/disposable-postgres-lifecycle.mjs certify"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
