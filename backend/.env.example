# PostgreSQL
POSTGRES_USER=sgi_user
POSTGRES_PASSWORD=sgi_local_password
POSTGRES_DB=sgi_curime
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sgi_user:sgi_local_password@localhost:5432/sgi_curime?schema=public
DIRECT_URL=postgresql://sgi_user:sgi_local_password@localhost:5432/sgi_curime?schema=public

# Puertos
BACKEND_PORT=3000
FRONTEND_PORT=5173

# URLs
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Definir explícitamente antes de ejecutar el seed; no se proporcionan credenciales predeterminadas
ADMIN_NAME=
ADMIN_IDENTIFICATION=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT
JWT_SECRET=dev-only-change-this-secret-before-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL=2592000
REFRESH_COOKIE_NAME=sgi_refresh
REFRESH_COOKIE_SAME_SITE=lax

# Seguridad
ACTIVATION_TOKEN_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PUBLIC_REQUEST_RATE_LIMIT_TTL_SECONDS=60
PUBLIC_REQUEST_RATE_LIMIT_MAX=5

# Correo
EMAIL_PROVIDER=fake
EMAIL_SEND_ENABLED=false
EMAIL_FROM=
EMAIL_FROM_NAME=Asociación de Desarrollo Integral de Curime
EMAIL_REPLY_TO=
GMAIL_USER=
GMAIL_APP_PASSWORD=
